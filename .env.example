# Copie este arquivo para .env e preencha. O .env nunca vai para o git.

# Token do bot (Discord Developer Portal > sua aplicação > Bot > Reset Token)
DISCORD_TOKEN=

# Seu ID de usuário do Discord: o bot entra no canal de voz em que você estiver.
# (Configurações > Avançado > Modo desenvolvedor; depois clique com o botão direito no seu nome > Copiar ID)
DISCORD_OWNER_ID=

# Porta da API local usada pelo Ulanzi / Stream Deck (opcional)
# MESTRONOMO_PORT=7777
