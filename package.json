{
  "name": "mestronomo",
  "version": "1.3.0",
  "description": "Ferramentas de áudio para mestres de RPG: música, ambiente e soundboard direto no Discord",
  "main": "dist/main/main.js",
  "scripts": {
    "build:capture": "cargo build --release --manifest-path capture/Cargo.toml",
    "build": "tsc",
    "start": "tsc && electron .",
    "typecheck": "tsc --noEmit",
    "icons": "electron scripts/render-icons.js",
    "plugin:ulanzi": "node scripts/instalar-plugin-ulanzi.js",
    "dist": "npm run build:capture && tsc && npm run icons && node scripts/preparar-vendor.js && electron-builder --win nsis --publish never && electron-builder --win --config scripts/electron-builder-portatil.js --publish never",
    "test": "tsc && node --test --test-force-exit --test-concurrency=1 --test-timeout=60000 \"test/*.test.js\""
  },
  "author": "paulo-vc",
  "license": "MIT",
  "type": "commonjs",
  "dependencies": {
    "@discordjs/voice": "^0.19.2",
    "discord.js": "^14.27.0",
    "dotenv": "^18.0.9",
    "electron-updater": "^6.8.11",
    "opusscript": "^0.0.8"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "electron": "^45.2.0",
    "electron-builder": "^26.18.0",
    "typescript": "^7.0.2"
  },
  "private": true,
  "productName": "Mestrônomo",
  "build": {
    "appId": "com.paulovc.mestronomo",
    "productName": "Mestrônomo",
    "executableName": "Mestronomo",
    "directories": {
      "output": "release/${version}"
    },
    "files": [
      "dist/**",
      "src/renderer/**",
      "assets/**",
      "tabelas/Exemplo*",
      "package.json",
      "!**/*.map"
    ],
    "extraResources": [
      {
        "from": "vendor",
        "to": "bin"
      },
      {
        "from": "pacotes",
        "to": "pacotes",
        "filter": [
          "**/*",
          "!fontes.json"
        ]
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "Mestrônomo",
      "installerIcon": "assets/icon.ico",
      "uninstallerIcon": "assets/icon.ico",
      "artifactName": "Mestronomo-Setup-${version}.${ext}"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "paulo-vc",
        "repo": "mestronomo"
      }
    ]
  }
}
