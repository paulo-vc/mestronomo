{
  "name": "mestronomo",
  "version": "1.0.0",
  "description": "Ferramentas de áudio para mestres de RPG: música, ambiente e soundboard direto no Discord",
  "main": "dist/main/main.js",
  "scripts": {
    "build:capture": "cargo build --release --manifest-path capture/Cargo.toml",
    "build": "tsc",
    "start": "tsc && electron .",
    "typecheck": "tsc --noEmit",
    "icons": "electron scripts/render-icons.js",
    "plugin:ulanzi": "node scripts/instalar-plugin-ulanzi.js"
  },
  "author": "",
  "license": "MIT",
  "type": "commonjs",
  "dependencies": {
    "@discordjs/voice": "^0.19.2",
    "discord.js": "^14.27.0",
    "dotenv": "^18.0.9",
    "opusscript": "^0.0.8"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "electron": "^45.2.0",
    "typescript": "^7.0.2"
  },
  "private": true
}
